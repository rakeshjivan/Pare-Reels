{
  "name": "pare-reels",
  "productName": "Pare Reels",
  "version": "1.0.0",
  "description": "Download videos from YouTube, Vimeo, webinars and more.",
  "main": "src/main.js",
  "author": "Rakesh Jivan",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "test": "node test/smoke.js"
  },
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.49.0"
  },
  "build": {
    "appId": "app.pare.reels",
    "productName": "Pare Reels",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Pare-Reels-Setup.exe",
      "shortcutName": "Pare Reels",
      "createDesktopShortcut": true
    }
  }
}
